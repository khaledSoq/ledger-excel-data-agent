# Copy to excel_data_agent/.env  (ADK loads this automatically)

# --- Backend: ollama | gemini | litellm ---
ADK_MODEL_PROVIDER=ollama

# Local default — any tool-calling Ollama model works.
# Check capabilities with:  ollama show llama3.2:3b
ADK_MODEL=ollama_chat/llama3.2:3b
OLLAMA_API_BASE=http://localhost:11434

# Alternatives:
# ADK_MODEL=ollama_chat/qwen2.5:7b
# ADK_MODEL=ollama_chat/gemma2:9b
# ADK_MODEL=ollama_chat/mistral-small3.1
# ADK_MODEL=ollama_chat/llama3.1:8b

# Generation
ADK_TEMPERATURE=0.1
ADK_MAX_TOKENS=2048
ADK_TOP_P=0.9
ADK_NUM_CTX=8192
ADK_TIMEOUT=180
ADK_LITELLM_DEBUG=false

# Optional Gemini (requires GOOGLE_API_KEY)
# ADK_MODEL_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=

# Optional other LiteLLM provider
# ADK_MODEL_PROVIDER=litellm
# ADK_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=

# I/O
EXCEL_AGENT_DATA_DIR=./data
EXCEL_AGENT_MAX_FILE_BYTES=52428800
EXCEL_AGENT_MAX_ROWS=500000
